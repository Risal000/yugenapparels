{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "price": {
      "type": "number",
      "description": "Product price"
    },
    "original_price": {
      "type": "number",
      "description": "Original price before discount"
    },
    "category": {
      "type": "string",
      "enum": [
        "tops",
        "bottoms",
        "activewear",
        "footwear",
        "accessories",
        "essentials",
        "anime",
        "thrift-surplus"
      ],
      "description": "Main category"
    },
    "subcategory": {
      "type": "string",
      "description": "Subcategory name"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "image_url": {
      "type": "string",
      "description": "Primary product image"
    },
    "hover_image_url": {
      "type": "string",
      "description": "Alternate hover image"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available sizes"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags like new_arrival, trending, limited_drop, featured"
    },
    "in_stock": {
      "type": "boolean",
      "default": true
    },
    "color_variants": {
      "type": "array",
      "description": "Color variants for the product",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Color name e.g. Chalk White"
          },
          "hex": {
            "type": "string",
            "description": "Hex color code e.g. #FFFFFF"
          },
          "image_url": {
            "type": "string",
            "description": "Image for this color variant"
          },
          "hover_image_url": {
            "type": "string",
            "description": "Hover image for this color variant"
          },
          "in_stock": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ]
}